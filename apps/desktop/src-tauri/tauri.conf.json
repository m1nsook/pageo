{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paglora",
  "version": "0.2.0",
  "identifier": "com.m1nsook.paglora",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paglora — Documentation Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 650,
        "backgroundColor": "#f8f9fb"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMjkwN0JCQTM3NTU2MkIKUldRclZuV2p1d2NwUXFzM3lLMWNBZEpFMHZNbytYRG5mcGRwODBrbWE2enpOSzNsTXJHMmd0WkkK",
      "endpoints": [
        "https://github.com/m1nsook/paglora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
