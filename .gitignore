# Bun / JavaScript
node_modules/
dist/
dist-ssr/
# Temporary and previous outputs used by the atomic site runtime build
packages/site-runtime/.dist-staging/
packages/site-runtime/.dist-previous/
coverage/
.vite/
*.tsbuildinfo

# Tauri / Rust (nested under apps/desktop)
**/src-tauri/target/
**/src-tauri/gen/schemas/
**/target/

# Local secrets, credentials, and signing keys (never commit these)
.env
.env.*
!.env.example
# Tauri signing keys (.key + .key.pub) and other exported public/private keys
*.key
*.pub
*.pem
*.p8
*.p12
*.pfx
*.p7b
*.jks
*.keystore
*.asc
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
# Portable project backups can contain private Markdown pages and assets
*.paglora

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NPM Tools
*.cmd
# Keep bun.lock and Cargo.lock tracked after local installation/build.
